# VibeCraft Environment Configuration

# 1. Supabase Cloud Configuration (PostgreSQL Database & JWT Authentication)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Google Gemini API (GenAI Planning & Co-Pilot Engine)
# Obtain this from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
